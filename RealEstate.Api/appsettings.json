{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": "RealEstateDb"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "RealEstate.Api",
    "Audience": "RealEstate.Client",
    "ExpiryHours": 24
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": ""
  },
  "Razorpay": {
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": ""
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "realestate:",
    "DefaultTtlMinutes": 10
  },
  "RabbitMQ": {
    "HostName": "",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "",
    "Password": "",
    "ExchangeName": "real-estate.embedding",
    "QueueName": "real-estate.embedding.reindex"
  }
}
