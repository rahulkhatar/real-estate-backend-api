{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": "RealEstateDb"
  },
  "Cache": {
    "DefaultTtlMinutes": 10
  },
  "RabbitMQ": {
    "HostName": "",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "",
    "Password": "",
    "UseSsl": false,
    "ExchangeName": "real-estate.embedding",
    "QueueName": "real-estate.embedding.reindex"
  }
}
